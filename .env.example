# Copie para .env.local e preencha. Nunca commite valores reais.

# Banco (Postgres padrão; local: pg_ctlcluster 16 main start)
DATABASE_URL=postgres://aprovo:aprovo@localhost:5432/aprovo
DATABASE_URL_TEST=postgres://aprovo:aprovo@localhost:5432/aprovo_test

# Auth.js
AUTH_SECRET=troque-por-um-segredo-longo-aleatorio   # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-mail (link mágico e avisos)
RESEND_API_KEY=
EMAIL_FROM="APROVO <onboarding@resend.dev>"

# Storage de mídia: "local" (dev, pasta .data/storage servida por /api/files) ou "s3" (R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# Cloudflare R2 ou qualquer S3 (usado quando STORAGE_DRIVER=s3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aprovo-media
R2_ENDPOINT=   # https://<account_id>.r2.cloudflarestorage.com

# Instagram: conexão OAuth feita em Configurações › Instagram (ADR-009: feeds só de contas conectadas)
META_OAUTH_PROVIDER=instagram   # instagram (padrão) | facebook
# Login do Instagram (padrão): conta profissional, sem Página do Facebook
META_APP_ID=            # Instagram App ID (produto Instagram no app da Meta)
META_APP_SECRET=        # Instagram App Secret
META_REDIRECT_URI=      # ${APP_URL}/api/instagram/callback (opcional; padrão derivado de APP_URL)
# Login do Facebook (opcional, META_OAUTH_PROVIDER=facebook): conta ligada a uma Página; permite Business Discovery
META_FB_APP_ID=         # ID do app da Meta (Login do Facebook)
META_FB_APP_SECRET=     # Chave secreta do app da Meta
META_FB_CONFIG_ID=      # opcional: ID de configuração do "Login do Facebook para Empresas" (substitui os escopos)
META_FB_REDIRECT_URI=   # opcional; padrão: ${APP_URL}/api/instagram/callback
# Alternativa sem OAuth: token manual de uma conta ponte (gerado no painel da Meta)
META_GRAPH_ACCESS_TOKEN=
META_IG_USER_ID=
# Publicação automática (Fase 6): quando "true", a conexão pede também o escopo instagram_business_content_publish
IG_PUBLISH_ENABLED=false
IG_PUBLISHER=   # `fake` para e2e/local sem Meta
# URL de "Desautorizar" no painel da Meta: https://aprovo-six.vercel.app/api/instagram/deauthorize
IG_FALLBACK_PROVIDER=none   # none | apify | scrapecreators (desligado por padrão)
IG_FALLBACK_API_KEY=

# Cron (renovação semanal do token do Instagram; a Vercel envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=   # openssl rand -hex 32

# App
APP_URL=http://localhost:3000
SENTRY_DSN=
